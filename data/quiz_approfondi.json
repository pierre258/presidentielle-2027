  "questions": [
    {
      "id": "a_pa_1",
      "theme": "pouvoir_achat",
      "axe": null,
      "q": "Il faut baisser la TVA sur l'énergie (carburants, électricité, gaz) de 20 % à 5,5 %."
    },
    {
      "id": "a_pa_2",
      "theme": "pouvoir_achat",
      "axe": "eco",
      "q": "L'État doit bloquer par la loi les prix des produits de première nécessité (alimentation, énergie)."
    },
    {
      "id": "a_pa_3",
      "theme": "pouvoir_achat",
      "axe": "eco",
      "q": "Pour mieux payer les salariés, il faut augmenter le temps de travail (par exemple 37 h 30 par semaine en échange d'un 13e mois).",
      "inv": true
    },
    {
      "id": "a_fisc_1",
      "theme": "fiscalite",
      "axe": "eco",
      "q": "Il faut créer un impôt minimal de 2 % sur les patrimoines de plus de 100 millions d'euros (« taxe Zucman »)."
    },
    {
      "id": "a_fisc_2",
      "theme": "fiscalite",
      "axe": "eco",
      "q": "Réduire la dette publique doit être la priorité, même au prix d'économies sur les dépenses sociales.",
      "inv": true
    },
    {
      "id": "a_fisc_3",
      "theme": "fiscalite",
      "axe": "eco",
      "q": "Il faut supprimer les droits de succession pour les classes moyennes.",
      "inv": true
    },
    {
      "id": "a_ret_1",
      "theme": "retraites",
      "axe": "eco",
      "q": "L'âge légal de départ à la retraite doit être porté à 65 ans.",
      "inv": true
    },
    {
      "id": "a_ret_2",
      "theme": "retraites",
      "axe": "eco",
      "q": "Il faut introduire une part de capitalisation (épargne individuelle ou collective) dans le système de retraite.",
      "inv": true
    },
    {
      "id": "a_sante_1",
      "theme": "sante",
      "axe": null,
      "q": "Il faut obliger les jeunes médecins à s'installer quelques années dans les déserts médicaux."
    },
    {
      "id": "a_sante_2",
      "theme": "sante",
      "axe": "eco",
      "q": "Tous les soins prescrits doivent être remboursés à 100 % par la Sécurité sociale, sans complémentaire."
    },
    {
      "id": "a_sante_3",
